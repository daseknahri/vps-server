# Secrets + runtime state — these must NEVER be committed (they live on the server's /data volume + Coolify env)
keys.json
key-audit.log
.env
.env.*
node_modules/
*.log
data/

# Ed25519 licence-SIGNING private key — belongs only in the Coolify env var (LICENSE_SIGNING_KEY).
# Whoever holds it can mint a valid licence for any machine.
signing-key.pem
*.pem
